# Ansible managed — rendered by the odem.services.monitoring role.

# Network bind configuration
BIND_IP={{ monitoring_bind_ip }}

# Service ports (host-side)
GRAFANA_PORT={{ monitoring_grafana_port }}
PROMETHEUS_PORT={{ monitoring_prometheus_port }}
LOKI_PORT={{ monitoring_loki_port }}

# Grafana admin credentials
GRAFANA_ADMIN_USER={{ monitoring_grafana_admin_user }}
GRAFANA_ADMIN_PASSWORD={{ monitoring_grafana_admin_password }}

# Image versions
PROMETHEUS_VERSION={{ monitoring_prometheus_version }}
LOKI_VERSION={{ monitoring_loki_version }}
GRAFANA_VERSION={{ monitoring_grafana_version }}

# Compose profiles. Empty starts only the core stack; "wazuh" also starts the
# Wazuh SIEM containers.
COMPOSE_PROFILES={{ 'wazuh' if (monitoring_enable_wazuh | bool) else '' }}

# Wazuh SIEM
WAZUH_VERSION={{ monitoring_wazuh_version }}
WAZUH_INDEXER_HEAP={{ monitoring_wazuh_indexer_heap_gb }}
WAZUH_AGENT_PORT={{ monitoring_wazuh_agent_port }}
WAZUH_ENROLLMENT_PORT={{ monitoring_wazuh_enrollment_port }}
WAZUH_TLS_PORT={{ monitoring_wazuh_tls_port }}
WAZUH_SYSLOG_PORT={{ monitoring_wazuh_syslog_port }}
WAZUH_API_PORT={{ monitoring_wazuh_api_port }}
WAZUH_DASHBOARD_PORT={{ monitoring_wazuh_dashboard_port }}
WAZUH_MANAGER_INDEXER_USER={{ monitoring_wazuh_manager_indexer_user }}
WAZUH_MANAGER_INDEXER_PASSWORD={{ monitoring_wazuh_manager_indexer_password }}
WAZUH_DASHBOARD_USER={{ monitoring_wazuh_dashboard_user }}
WAZUH_DASHBOARD_PASSWORD={{ monitoring_wazuh_dashboard_password }}
